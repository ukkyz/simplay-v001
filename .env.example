# ---------------------------------------------------------------------------
# Simplayz — environment template. Copy to `.env.local` and fill in locally.
# NEVER commit real secrets. There are no NEXT_PUBLIC_* secret variables:
# anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle.
# ---------------------------------------------------------------------------

# SQLite file path. Default: <repo>/data/simplayz.sqlite
# Use an absolute path on a persistent volume in deployment.
SIMPLAYZ_DB_PATH=./data/simplayz.sqlite

# Add `Secure` to the anonymous-session cookie. `true` in production/HTTPS,
# `false` only for plain-HTTP local development.
SIMPLAYZ_COOKIE_SECURE=false

# Optional: comma-separated extra dev origins allowed to talk to `next dev`
# (the Arena preview domain *.e2b.app is allowed by default).
# SIMPLAYZ_DEV_ORIGINS=https://my-preview.example.com

# ---------------------------------------------------------------------------
# Optional live executive advisor. When the fields are absent the boardroom
# always uses the local rule-based advisor. Keys stay server-side only.
# ---------------------------------------------------------------------------
# SIMPLAYZ_AI_API_KEY=
# SIMPLAYZ_AI_BASE_URL=https://api.openai.com/v1
# SIMPLAYZ_AI_MODEL=gpt-4o-mini
# Optional comma-separated allowlists (defaults to the two values above):
# SIMPLAYZ_AI_ALLOWED_BASE_URLS=https://api.openai.com/v1
# SIMPLAYZ_AI_ALLOWED_MODELS=gpt-4o-mini
# Request timeout in ms (default 12000):
# SIMPLAYZ_AI_TIMEOUT_MS=12000
# Per-session advisor requests per minute (default 10; in-memory, single server):
# SIMPLAYZ_AI_RATE_LIMIT_PER_MINUTE=10
